{
	"compilerOptions": {
		"target": "ES6",
		"module": "ESNext",
		"moduleResolution": "Node",
		"outDir": "dist",
		"declaration": true,
		"declarationDir": "dist/types",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"strict": true,
        "strictNullChecks": false, // Note: I use optional changing and heavily rely on `null` and `undefined` values in the codebase. Please do not set this to true unless you want the compiler to throw a fucking temper tantrum every time you try to access a property of an object that may or may not be null or undefined. I have better things to do than to deal with that nonsense.
		"noImplicitAny": true,
		"paths": {
			"@Components.Utilities/*": ["./src/components/utilities/*"],
			"@Components.Classes/*": ["./src/components/classes/*"],
			"@Components.Stanza/*": ["./src/components/stanza/*"],
			"@Components.Geometry/*": ["./src/components/geometry/*"],
			"@Components.Database/*": ["./src/components/database/*"],
			"@Components.Database.Building/*": ["./src/components/database/building/*"],
			"@Components.Database.Queries/*": ["./src/components/database/queries/*"],
			"@Components.Events/*": ["./src/components/events/*"],
			"@Components.Events.Parsing/*": ["./src/components/events/parsing/*"],
			"@Components.Events.VTEC/*": ["./src/components/events/parsing/vtec/*"],
			"@Components.Events.HVTEC/*": ["./src/components/events/parsing/hvtec/*"],
			"@Components.Events.UGC/*": ["./src/components/events/parsing/ugc/*"],
			"@Components.Events.Text/*": ["./src/components/events/parsing/text/*"],
			"@Components.Events.Building/*": ["./src/components/events/building/*"],
			"@Components.Events.Managers/*": ["./src/components/events/managers/*"],
			"@Enums/*": ["./src/enums/*"],
			"@Enums.Properties/*": ["./src/enums/properties/*"],
			"@Enums.Products/*": ["./src/enums/products/*"],
			"@Enums.Events/*": ["./src/enums/events/*"],
			"@Enums.Flooding/*": ["./src/enums/flooding/*"],
			"@Enums.Geographic/*": ["./src/enums/geographic/*"],
			"@Exports/*": ["./src/exports/*"],
			"Types/*": ["./src/types/*"],
			"Types.Event/*": ["./src/types/event/*"],
			"Types.Stanza/*": ["./src/types/stanza/*"],
			"Types.Components/*": ["./src/types/components/*"],
			"@Bootstrap": ["./src/bootstrap.ts"],
		}
	},
	"include": ["src"]
}